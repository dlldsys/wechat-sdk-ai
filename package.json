{
  "name": "wechat-sdk-ai",
  "version": "1.0.3",
  "description": "A comprehensive Node.js SDK for WeChat Official Accounts and Mini Programs",
  "homepage": "https://github.com/dlldsys/wechat-sdk-ai#readme",
  "bugs": {
    "url": "https://github.com/dlldsys/wechat-sdk-ai/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dlldsys/wechat-sdk-ai.git"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "wechat",
    "weixin",
    "miniprogram",
    "official-account",
    "sdk",
    "typescript"
  ],
  "author": "dlldsys <dlldsys@example.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.55.0",
    "ioredis": "^5.10.1",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "ioredis": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
