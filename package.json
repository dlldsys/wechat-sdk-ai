{
  "name": "wechat-sdk-ai",
  "version": "1.0.4",
  "description": "A comprehensive Node.js SDK for WeChat Official Accounts and Mini Programs",
  "homepage": "https://github.com/dlldsys/wechat-sdk-ai#readme",
  "bugs": {
    "url": "https://github.com/dlldsys/wechat-sdk-ai/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dlldsys/wechat-sdk-ai.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "require": "./dist/index.d.cts",
        "import": "./dist/index.d.ts"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    ">=4.0": {
      "*": ["dist/index.d.ts"]
    },
    ">=3.8 <4.0": {
      "*": ["dist/index.d.ts"]
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:fast": "tsup --no-dts",
    "dev": "tsup --watch",
    "prebuild": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "wechat",
    "weixin",
    "miniprogram",
    "official-account",
    "sdk",
    "typescript"
  ],
  "author": {
    "name": "dlldsys",
    "url": "https://github.com/dlldsys"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.55.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "ioredis": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
